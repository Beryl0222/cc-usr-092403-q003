      "自动升级": false
    },
    {
      "等级": "直接人身威胁",
      "编码": "direct_threat",
      "说明": "含人身伤害、死亡威胁或对住所、行踪的现实威胁，必须按值班规则立即升级",
      "可立案": true,
      "自动升级": true
    }
  ],
