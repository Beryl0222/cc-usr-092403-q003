  "聚类": {
    "策略": "对受侵害当事人相同且内容哈希一致、或平台账号相同的线索给出合并建议；系统只产生建议，由俱乐部保护专员人工确认后才合并",
    "键": ["victim_code+content_sha256", "linked_account_key"]
  },
  "回调幂等": {
    "说明": "平台或证据采集回调以 callback_id 去重：同一 callback_id 只处理一次；回执状态更新到既有事件，不重复通知、不产生第二案件",
    "重复响应": "返回首次处理结果，并标注 duplicate=true"
  },
  "误报申诉": {
    "说明": "事件被标记误报或当事人申诉期间，事件置为申诉中，敏感材料仅对法务复核员与俱乐部值班主管可见，并阻断新的对外动作",
    "敏感脱敏": ["content_ref", "raw_excerpt", "linked_accounts"],
    "可见角色例外": ["法务复核员", "俱乐部值班主管"]
  },
  "材料保全移交": {
    "说明": "法务按案件与用途签发带版本、期限、字段范围的保全令，系统据此固化不可变材料清单与摘要；交出/接收双方分别签认。拒收、退回、补件、司法延长只追加衔接事件，不改写先前回执；重复移交不再通知、不生成第二份清单，内容变化进入冲突复核。",
    "签发角色": "法务复核员",
    "交出角色": ["俱乐部保护专员", "法务复核员"],
    "接收角色": ["外部调查机构"],
    "保全用途": [
      {"编码": "external_investigation", "名称": "外部机构调查", "说明": "向外部调查机构移交严重事件材料"},
      {"编码": "judicial_transfer", "名称": "司法移交", "说明": "配合报案、司法程序移交并依法保全"},
      {"编码": "internal_legal", "名称": "内部法务核查", "说明": "仅供法务内部核查，不对外交出"}
    ],
    "材料字段": [
      {"编码": "victim_code", "名称": "当事人编号", "最小保全": true},
      {"编码": "content_ref", "名称": "受控内容引用", "最小保全": true},
      {"编码": "content_sha256", "名称": "内容哈希", "最小保全": true},
      {"编码": "evidence_note", "名称": "证据说明", "最小保全": false},
      {"编码": "linked_accounts", "名称": "关联账号", "最小保全": false},
      {"编码": "platform_receipts", "名称": "平台回执", "最小保全": false},
      {"编码": "action_chain", "名称": "处置责任链", "最小保全": false},
      {"编码": "raw_contact", "名称": "当事人联系方式", "最小保全": false}
    ],
    "默认期限天": {
      "external_investigation": 180,
      "judicial_transfer": 730,
      "internal_legal": 90
    },
    "最小保全规则": "申诉、账号改名或当事人撤回非核心授权后，依法/司法存续所需的最小材料继续留存；任何新增对外披露必须重新核权。",
    "最小保全字段": ["victim_code", "content_ref", "content_sha256"],
    "退回原因": ["来源无法确认", "交出责任不清", "授权期限不明", "材料不完整", "其他"],
    "重复移交": "同一案件+同一接收机构+同一用途再次移交时，不发通知、不生成第二份清单；若拟交内容与已签认清单不一致，生成冲突复核任务而非覆盖旧清单。",
    "服务中断恢复": "从中断前最后一个确认节点（已签发/已签认）恢复，未确认的中间动作不补做。",
    "脱敏查看": {
      "说明": "普通案件查看者只能获得其角色允许的脱敏内容：当事人编号、账号、引用、联系方式按规则掩码，仅可见保全令元信息与字段级状态。",
      "角色": "普通案件查看者",
      "脱敏字段": ["victim_code", "content_ref", "linked_accounts", "raw_contact"],
      "掩码": "****"
    }
  },
  "责任链": {
    "说明": "内容删除、账号改名、证据补充、授权撤回、保全移交各环节（拒收/退回/补件/延长/冲突）均只追加变更记录，不覆盖、不删除既有证据、清单与回执；任意时刻可还原事件全过程"
  },
